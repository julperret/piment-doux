// use prisma-8

model User {
  id                Int               @id @default(autoincrement())
  lastName          VarChar(50)       @map("last_name")
  firstName         VarChar(50)       @map("first_name")
  email             VarChar(300)   
  passwordHash      VarChar(255)?     @map("password_hash")
  role              Role              @default(user)
  emailVerifiedAt   Timestamptz?      @map("email_verified_at")
  createdAt         Timestamptz       @default(now()) @map("created_at")
  updatedAt         Timestamptz?      @map("updated_at")
  deletedAt         Timestamptz?      @map("deleted_at")
  addresses         Address[]
  orders            Order[]
  tokens            Token[]
  posts             Post[]
  inquiries         Inquiry[]

  @@map("users")
}

enum Role {
  @@type("pg/text@1")
  user
  guest
  admin
}

model Product {
  id                  Int             @id @default(autoincrement())
  slug                VarChar(100)
  label               VarChar(100)
  description         String
  stockQuantity       Int             @map("stock_quantity")
  price               Numeric(10, 2) 
  createdAt           Timestamptz     @default(now()) @map("created_at")
  updatedAt           Timestamptz?    @map("updated_at")
  deletedAt           Timestamptz?    @map("deleted_at")
  orderLines          OrderLine[]
  media               Media[]

  @@map("products")
}

model Address {
  id                  Int             @id @default(autoincrement())
  userId              Int             @map("user_id")
  user                User            @relation(fields: [userId], references: [id])
  label               VarChar(50)   
  street              VarChar(100)
  city                VarChar(50)
  postalCode          VarChar(20)     @map("postal_code")
  country             VarChar(50)
  phone               VarChar(20)
  createdAt           Timestamptz     @default(now()) @map("created_at")
  updatedAt           Timestamptz?    @map("updated_at")

  @@map("addresses")
}

model Order {
  id                  Int             @id @default(autoincrement())
  userId              Int             @map("user_id")
  user                User            @relation(fields: [userId], references: [id])
  status              StatusValue
  deliveryStreet      VarChar(100)    @map("delivery_street")
  deliveryCity        VarChar(50)     @map("delivery_city")
  deliveryPostalCode  VarChar(20)     @map("delivery_postal_code")
  deliveryCountry     VarChar(50)     @map("delivery_country")
  deliveryPhone       VarChar(20)     @map("delivery_phone")
  billingStreet       VarChar(100)    @map("billing_street")
  billingCity         VarChar(50)     @map("billing_city")
  billingPostalCode   VarChar(20)     @map("billing_postal_code")
  billingCountry      VarChar(50)     @map("billing_country")
  billingPhone        VarChar(20)     @map("billing_phone")
  paidAt              Timestamptz?    @map("paid_at")
  createdAt           Timestamptz     @default(now()) @map("created_at")
  updatedAt           Timestamptz?    @map("updated_at")
  orderStatuses       OrderStatus[]
  orderLines          OrderLine[]   

  @@map("orders")
}

model OrderStatus {
  id                  Int             @id @default(autoincrement())
  orderId             Int             @map("order_id")
  order               Order           @relation(fields: [orderId], references: [id])
  status              StatusValue
  changedAt           Timestamptz     @default(now()) @map("changed_at")

  @@map("order_statuses")
}

enum StatusValue {
  @@type("pg/text@1")
  pending
  processing
  shipped
  delivered
  cancelled
}

model OrderLine {
  orderId             Int             @map("order_id")
  order               Order           @relation(fields: [orderId], references: [id])
  productId           Int             @map("product_id")
  product             Product         @relation(fields: [productId], references: [id])
  quantity            Int
  discountPercent     Numeric(5, 2)   @default(0) @map("discount_percent")
  unitPrice           Numeric(10, 2)  @map("unit_price")

  @@id([orderId, productId])
  @@map("order_lines")
}

model Token {
  id                  Int             @id @default(autoincrement())
  userId              Int             @map("user_id")
  user                User            @relation(fields: [userId], references: [id])
  valueHash           VarChar(255)    @unique @map("value_hash")
  type                VarChar(50)
  createdAt           Timestamptz     @default(now()) @map("created_at")
  expiresAt           Timestamptz     @map("expires_at")
  usedAt              Timestamptz?    @map("used_at")

  @@map("tokens")
}

model Inquiry {
  id                  Int             @id @default(autoincrement())
  userId              Int             @map("user_id")
  user                User            @relation(fields: [userId], references: [id])
  status              InquiryValue    @default(new)
  message             String
  eventDate           Date?           @map("event_date")
  guestCount          Int?            @map("guest_count")
  createdAt           Timestamptz     @default(now()) @map("created_at")
  updatedAt           Timestamptz?    @map("updated_at")

  @@map("inquiries")
}

enum InquiryValue {
  @@type("pg/text@1")
  new
  handled
}

model Media {
  id                  Int             @id @default(autoincrement())
  filePath            VarChar(2048)   @map("file_path")
  altText             VarChar(255)    @map("alt_text")
  mimeType            VarChar(50)     @map("mime_type")
  createdAt           Timestamptz     @default(now()) @map("created_at")
  coverPosts          Post[]          @relation("CoverMedia")
  posts               Post[]
  products            Product[]
  
  @@map("media")
}

model Post {
  id                  Int             @id @default(autoincrement())
  userId              Int             @map("user_id")
  user                User            @relation(fields: [userId], references: [id])
  coverMediaId        Int?            @map("cover_media_id")
  coverMedia          Media?          @relation("CoverMedia", fields: [coverMediaId], references: [id])
  title               VarChar(100)
  slug                VarChar(100)    @unique
  content             String
  status              PostValue
  publishedAt         Timestamptz?    @map("published_at")
  createdAt           Timestamptz     @default(now()) @map("created_at")
  updatedAt           Timestamptz?    @map("updated_at")
  media               Media[]

  @@map("posts")
}

enum PostValue {
  @@type("pg/text@1")
  draft
  published
  archived
}

model PostMedia {
  postId              Int             @map("post_id")
  post                Post            @relation(fields: [postId], references: [id])
  mediaId             Int             @map("media_id")
  media               Media           @relation(fields: [mediaId], references: [id])

  @@id([postId, mediaId])
  @@map("post_media")
}

model ProductMedia {
  productId           Int             @map("product_id")
  product             Product         @relation(fields: [productId], references: [id])
  mediaId             Int             @unique @map("media_id")
  media               Media           @relation(fields: [mediaId], references: [id])

  @@id([productId, mediaId])
  @@map("product_media")
}
